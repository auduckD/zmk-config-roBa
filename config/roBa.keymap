#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <2>;
    scroll-layers = <3>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R             &kp T                                                           &kp Y      &kp U  &kp I                     &kp O   &lt_to_layer_0 3 P
&kp A      &kp S         &kp D         &kp F             &kp G                        &bt BT_NXT          &trans         &kp H      &kp J  &kp K                     &kp L   &mt UNDERSCORE MINUS
&kp Z      &kp X         &kp C         &kp V             &kp TAB                      &kp LEFT_SHIFT      &kp B          &kp N      &kp M  &mt QUESTION EXCLAMATION  &trans  &trans
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 LANGUAGE_4  &lt_to_layer_0 1 LANGUAGE_7  &kp SPACE           &kp BACKSPACE  &kp ENTER                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(PLUS) LG(MINUS)>;
        };

        layer_1 {
            bindings = <
&trans  &kp LC(LS(TAB))   &kp UP_ARROW    &kp LC(TAB)        &trans                           &kp N1            &kp N2  &kp N3  &kp PLUS      &kp MINUS
&trans  &kp LEFT          &kp DOWN_ARROW  &kp RIGHT          &trans  &trans      &kp AT_SIGN  &kp N4            &kp N5  &kp N6  &kp ASTERISK  &kp FSLH
&trans  &kp LG(LS(LEFT))  &trans          &kp LG(LS(RIGHT))  &trans  &trans      &kp DOT      &kp N7            &kp N8  &kp N9  &kp N0        &kp PERCENT
&trans  &trans            &trans          &trans             &trans  &trans      &trans       &kp LEFT_CONTROL                                &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans            &mkp LCLK  &mkp RCLK  &kp LS(LC(LG(NUMBER_4)))  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans            &kp C      &kp V      &kp LS(V)                 &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans            &trans     &trans     &trans                    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LEFT_CONTROL                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(PLUS) LG(MINUS)>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
